#include <acl/acl.h>
#include <type_traits>

static_assert(sizeof(__fp8e6m2) == 1);
static_assert(__is_floating_point(__fp8e6m2));
static_assert(!__is_same(__fp8e6m2, __fp8e5m2));
static_assert(!__is_same(__fp8e6m2, __fp8e8m0));
static_assert(__is_same(decltype(__fp8e6m2{}), __fp8e6m2));
static_assert(__is_same(decltype(__fp8e5m2(0)), __fp8e5m2));

using fp8e6m2x2 = __fp8e6m2 __attribute__((ext_vector_type(2)));
static_assert(sizeof(fp8e6m2x2) == 2);

constexpr int fp8_kind(__fp8e6m2) { return 6; }
constexpr int fp8_kind(__fp8e5m2) { return 5; }
static_assert(fp8_kind(__fp8e6m2{}) == 6);
static_assert(fp8_kind(__fp8e5m2{}) == 5);

static_assert(std::is_same_v<decltype(get_block_idx()), int32_t>);
static_assert(std::is_same_v<decltype(get_block_num()), int32_t>);

__aicore__ void check_cann_interfaces() {
    dim3 grid(2, 3, 4);
    int32_t index = get_block_idx();
    int32_t count = get_block_num();
    (void)grid;
    (void)index;
    (void)count;
}
