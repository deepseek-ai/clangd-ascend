#include <cstdio>
#include <acl/acl.h>
#include <kernel_operator.h>

struct wrap16_t { uint16_t val; };

extern "C" __global__ __vector__ void k_w8_w8(__gm__ uint64_t* out, wrap16_t a, wrap16_t b, uint32_t c) {
    out[0] = a.val;
    out[1] = b.val;
    out[2] = c;
}

int main() {
    aclInit(nullptr);
    aclrtSetDevice(0);

    aclrtStream stream;
    aclrtCreateStream(&stream);

    void* dev_out = nullptr;
    aclrtMalloc(&dev_out, 3 * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dev_out, 3 * sizeof(uint64_t), 0, 3 * sizeof(uint64_t));

    wrap16_t a = {0xaaaa};
    wrap16_t b = {0xbbbb};
    uint32_t c = 0xcccccccc;
    k_w8_w8<<<1, 0, stream>>>((__gm__ uint64_t*)dev_out, a, b, c);
    aclrtSynchronizeStream(stream);

    uint64_t host_out[3] = {};
    aclrtMemcpy(host_out, 24, dev_out, 24, ACL_MEMCPY_DEVICE_TO_HOST);

    ::fprintf(stdout, "out[0] = 0x%lx (expect 0xaaaa)\n", host_out[0]);
    ::fprintf(stdout, "out[1] = 0x%lx (expect 0xbbbb)\n", host_out[1]);
    ::fprintf(stdout, "out[2] = 0x%lx (expect 0xcccccccc)\n", host_out[2]);
    ::fprintf(stdout, "%s\n", (host_out[0] == 0xaaaa && host_out[1] == 0xbbbb && host_out[2] == 0xcccccccc) ? "PASS" : "FAIL");

    aclrtFree(dev_out);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return !(host_out[0] == 0xaaaa && host_out[1] == 0xbbbb && host_out[2] == 0xcccccccc);
}
