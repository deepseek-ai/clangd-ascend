#include "ascend.hpp"

using namespace deep_gemm;

// Unified tile swizzle: tile_idx -> (out_m, out_n) tile coordinates.
template<uint32_t GROUP_M = 4, bool XOR_N = true, bool SNAKE = true>
__aicore__ inline void tile_swizzle(uint32_t tile_idx, uint32_t num_m, uint32_t num_n,
                                           uint32_t &out_m, uint32_t &out_n) {
    static_assert(GROUP_M == 4 || GROUP_M == 8, "GROUP_M must be 4 or 8");
    constexpr uint32_t GROUP_N = 32 / GROUP_M;

    if(num_m < GROUP_M) {
        out_m = tile_idx / num_n;
        out_n = tile_idx % num_n;
        return;
    }

    uint32_t blocks_n = num_n / GROUP_N;
    uint32_t rem_n    = num_n % GROUP_N;
    uint32_t tiles_per_superrow = GROUP_M * num_n;
    uint32_t full_tiles = blocks_n * 32;

    uint32_t superrow = tile_idx / tiles_per_superrow;
    uint32_t within   = tile_idx % tiles_per_superrow;

    if(within < full_tiles) {
        uint32_t blk   = within / 32;
        uint32_t local = within % 32;
        uint32_t m_local = local % GROUP_M;
        uint32_t n_local = local / GROUP_M;
        if(XOR_N) n_local ^= (local % GROUP_M);

        uint32_t bn = blk;
        if(SNAKE && (superrow & 1)) bn = blocks_n - 1 - bn;

        out_m = superrow * GROUP_M + m_local;
        out_n = bn * GROUP_N + n_local;
    } else {
        uint32_t rem_within = within - full_tiles;
        uint32_t m_local = rem_within % GROUP_M;
        uint32_t n_local = rem_within / GROUP_M;

        out_m = superrow * GROUP_M + m_local;
        out_n = blocks_n * GROUP_N + n_local;
    }
}

// BF16 GEMM (NT layout): C[M,N] = A[M,K] @ B[N,K].T
// Mix kernel: 1 AIC + 2 AIV
//   AIC: GM->L1->L0A/L0B->mad->L0C->UB (dualDst M-split)
//   AIV: UB->GM
template<
    uint32_t SHAPE_M, uint32_t SHAPE_N, uint32_t SHAPE_K,
    uint32_t BLOCK_M, uint32_t BLOCK_N, uint32_t BLOCK_K,
    uint32_t MAD_BLOCK_M, uint32_t MAD_BLOCK_N, uint32_t MAD_BLOCK_K,
    uint32_t kNumLoadStages,
    uint32_t kNumMadABStages,
    uint32_t kNumCores,
    uint32_t L2_CTRL_A = 0,
    uint32_t L2_CTRL_B = 0
>
__global__ __mix__(1, 2) void bf16_gemm_impl(
    __gm__ bfloat16_t * A,
    __gm__ bfloat16_t * B,
    __gm__ float * CD
) {
    constexpr uint32_t num_block_m = ceildiv(SHAPE_M, BLOCK_M);
    constexpr uint32_t num_block_n = ceildiv(SHAPE_N, BLOCK_N);
    constexpr uint32_t num_block_k = ceildiv(SHAPE_K, BLOCK_K);
    constexpr uint32_t num_tiles   = num_block_m * num_block_n;
    constexpr uint32_t kNumMadCDStages = (BLOCK_M / MAD_BLOCK_M) * (BLOCK_N / MAD_BLOCK_N);

    // Buffer size calculations (in bytes)
    constexpr uint64_t l1a_stage_size  = BLOCK_M * BLOCK_K * sizeof(bfloat16_t);
    constexpr uint64_t l1b_stage_size  = BLOCK_N * BLOCK_K * sizeof(bfloat16_t);
    constexpr uint64_t l0a_stage_size  = MAD_BLOCK_M * MAD_BLOCK_K * sizeof(bfloat16_t);
    constexpr uint64_t l0b_stage_size  = MAD_BLOCK_N * MAD_BLOCK_K * sizeof(bfloat16_t);
    constexpr uint64_t l0c_stage_size  = MAD_BLOCK_M * MAD_BLOCK_N * sizeof(float);
    // UB holds half of MAD_BLOCK_M due to DualDst M-split
    constexpr uint64_t ub_stage_size   = (MAD_BLOCK_M / 2) * MAD_BLOCK_N * sizeof(float);

    // Buffer base addresses (L1: A then B)
    constexpr uint64_t l1a_base = 0;
    constexpr uint64_t l1b_base = l1a_stage_size * kNumLoadStages;

    // Static assertions for buffer overflow
    static_assert(l1b_base + l1b_stage_size * kNumLoadStages <= L1SizeBytes,  "L1 overflow");
    static_assert(l0a_stage_size * kNumMadABStages <= L0ASizeBytes, "L0A overflow");
    static_assert(l0b_stage_size * kNumMadABStages <= L0BSizeBytes, "L0B overflow");
    static_assert(l0c_stage_size * kNumMadCDStages <= L0CSizeBytes, "L0C overflow");
    static_assert(ub_stage_size  * kNumMadCDStages <= UBSizeBytes,  "UB overflow");

    uint32_t core_id = get_block_idx();

    if ASCEND_IS_AIC {
        // Global prologue: prime all self-sustaining flags once
        set_flags<PIPE_MTE1, PIPE_MTE2, kNumLoadStages >();
        set_flags<PIPE_M,    PIPE_MTE1, kNumMadABStages>();
        set_flags<PIPE_FIX,  PIPE_M,    kNumMadCDStages>();

        for(uint32_t tile_idx = core_id; tile_idx < num_tiles; tile_idx += kNumCores) {
            uint32_t tile_m, tile_n;
            tile_swizzle(tile_idx, num_block_m, num_block_n, tile_m, tile_n);
            auto a_ptr = A + (uint64_t)tile_m * BLOCK_M * SHAPE_K;
            auto b_ptr = B + (uint64_t)tile_n * BLOCK_N * SHAPE_K;

            // K-loop
            for(uint32_t k_blk_idx = 0, s = 0; k_blk_idx < num_block_k; k_blk_idx++, s = (s + 1) % kNumLoadStages, a_ptr += BLOCK_K, b_ptr += BLOCK_K) {
                // --- Stage 1: GM -> L1[s] (MTE2) ---
                wait_flag(PIPE_MTE1, PIPE_MTE2, s);

                l1_ptr<bfloat16_t> l1a(l1a_base + s * l1a_stage_size, BLOCK_M, BLOCK_K);
                l1_ptr<bfloat16_t> l1b(l1b_base + s * l1b_stage_size, BLOCK_N, BLOCK_K);

                copy_gm_to_l1(l1a, a_ptr, SHAPE_K * sizeof(bfloat16_t), ND, (L2Ctrl)L2_CTRL_A);
                copy_gm_to_l1(l1b, b_ptr, SHAPE_K * sizeof(bfloat16_t), ND, (L2Ctrl)L2_CTRL_B);

                set_flag(PIPE_MTE2, PIPE_MTE1, s);

                // --- Stage 2: L1[s] -> L0[s_ab] -> MAD ---
                wait_flag(PIPE_MTE2, PIPE_MTE1, s);
                for(uint32_t m_mad_idx = 0, s_cd = 0; m_mad_idx < BLOCK_M; m_mad_idx += MAD_BLOCK_M) {
                    for(uint32_t n_mad_idx = 0; n_mad_idx < BLOCK_N; n_mad_idx += MAD_BLOCK_N, s_cd = (s_cd + 1) % kNumMadCDStages) {
                        #pragma unroll
                        for(uint32_t k_mad_idx = 0, s_ab = 0; k_mad_idx < BLOCK_K; k_mad_idx += MAD_BLOCK_K, s_ab = (s_ab + 1) % kNumMadABStages) {
                            bool is_first = k_blk_idx == 0 && k_mad_idx == 0;
                            bool is_last  = k_blk_idx == num_block_k - 1 && k_mad_idx == BLOCK_K - MAD_BLOCK_K;

                            // L1 -> L0A/L0B (MTE1)
                            wait_flag(PIPE_M, PIPE_MTE1, s_ab);

                            l0a_ptr<bfloat16_t> l0a(s_ab * l0a_stage_size, MAD_BLOCK_M, MAD_BLOCK_K);
                            l0b_ptr<bfloat16_t> l0b(s_ab * l0b_stage_size, MAD_BLOCK_N, MAD_BLOCK_K);

                            copy_l1_to_l0a(l0a, l1a, m_mad_idx, k_mad_idx);
                            copy_l1_to_l0b(l0b, l1b, n_mad_idx, k_mad_idx);

                            set_flag(PIPE_MTE1, PIPE_M, s_ab);

                            // MAD (M pipe)
                            wait_flag(PIPE_MTE1, PIPE_M, s_ab);
                            if(is_first) {
                                wait_flag(PIPE_FIX, PIPE_M, s_cd);
                                wait_intra_block(PIPE_FIX, 0, s_cd);
                                wait_intra_block(PIPE_FIX, 1, s_cd);
                            }

                            l0c_ptr<float> l0c(s_cd * l0c_stage_size, MAD_BLOCK_M, MAD_BLOCK_N);

                            if(is_last) {
                                mad(l0c, l0a, l0b, UF_LAST, is_first);
                            } else {
                                mad(l0c, l0a, l0b, UF_ENABLE, is_first);
                            }

                            if(is_last) {
                                // L0C -> UB with DualDst M-split
                                ub_ptr<float>  ub (s_cd * ub_stage_size, MAD_BLOCK_M / 2, MAD_BLOCK_N);
                                copy_l0c_to_ub(ub, l0c, UF_LAST, DUAL_M);

                                set_intra_block(PIPE_FIX, 0, s_cd);
                                set_intra_block(PIPE_FIX, 1, s_cd);
                                set_flag(PIPE_FIX, PIPE_M, s_cd);
                            }

                            set_flag(PIPE_M, PIPE_MTE1, s_ab);
                        }
                    }
                }
                set_flag(PIPE_MTE1, PIPE_MTE2, s);
            }
        }
    } else {
        // AIV: UB -> GM
        auto sub_id = get_subblockid();

        // Prime intra-block flags for all CD stages
        for(uint32_t s_cd = 0; s_cd < kNumMadCDStages; s_cd++) {
            set_intra_block(PIPE_MTE3, sub_id, s_cd);
        }

        for(uint32_t tile_idx = core_id; tile_idx < num_tiles; tile_idx += kNumCores) {
            uint32_t tile_m, tile_n;
            tile_swizzle(tile_idx, num_block_m, num_block_n, tile_m, tile_n);
            auto cd_base = CD + (uint64_t)(tile_m * BLOCK_M + sub_id * MAD_BLOCK_M / 2) * SHAPE_N + tile_n * BLOCK_N;

            for(uint32_t m_mad_idx = 0, s_cd = 0; m_mad_idx < BLOCK_M; m_mad_idx += MAD_BLOCK_M) {
                for(uint32_t n_mad_idx = 0; n_mad_idx < BLOCK_N; n_mad_idx += MAD_BLOCK_N, s_cd = (s_cd + 1) % kNumMadCDStages) {
                    // Wait for AIC to finish cc_to_ub
                    wait_intra_block(PIPE_MTE3, sub_id, s_cd);

                    // UB -> GM
                    ub_ptr<float> ub(s_cd * ub_stage_size, MAD_BLOCK_M / 2, MAD_BLOCK_N);
                    auto gm_dst = cd_base + (uint64_t)m_mad_idx * SHAPE_N + n_mad_idx;

                    copy_ub_to_gm(gm_dst, ub, SHAPE_N * sizeof(float), L2_NOTALLOC_DROP);

                    // Notify AIC: UB is free
                    set_intra_block(PIPE_MTE3, sub_id, s_cd);
                }
            }
        }
    }
}

#ifndef INST_L2_CTRL_A
#define INST_L2_CTRL_A 0
#endif
#ifndef INST_L2_CTRL_B
#define INST_L2_CTRL_B 0
#endif

#ifdef INST_SHAPE_M
template __global__ __mix__(1, 2) void bf16_gemm_impl<
    INST_SHAPE_M,
    INST_SHAPE_N,
    INST_SHAPE_K,
    INST_BLOCK_M,
    INST_BLOCK_N,
    INST_BLOCK_K,
    INST_MAD_BLOCK_M,
    INST_MAD_BLOCK_N,
    INST_MAD_BLOCK_K,
    INST_NUM_L1_STAGES,
    INST_NUM_L0AB_STAGES,
    INST_NUM_CORES,
    INST_L2_CTRL_A,
    INST_L2_CTRL_B
>(
    __gm__ bfloat16_t * A,
    __gm__ bfloat16_t * B,
    __gm__ float * CD
);
#endif
