#include <cstdio>
#include "kernel_operator.h"

__simt_vf__ __launch_bounds__(32) inline void printf_vf(__gm__ int* data) {
    int tx = threadIdx.x;
    atomicAdd(data, 1);
    if (tx < 4) {
        printf("[SimtVF] block=%d thread=%d data[%d]=%d\n",
               (int)threadIdx.x, tx, tx, data[tx]);
    }
}

extern "C" __global__ __vector__
void test_simt_printf(__gm__ int* data) {
    pipe_barrier(pipe_t::PIPE_ALL);
    asc_vf_call<printf_vf>(cce::dim3(32), data);
    pipe_barrier(pipe_t::PIPE_ALL);
}
