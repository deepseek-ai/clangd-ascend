+/// TrySkipCCEScopeAnnotation - Check if the current token starts an Ascend CCE
+/// scope annotation like [aicore], [aicore, host], or [aicpu]. If so, consume
+/// all tokens up to and including the closing ']' and return true. Otherwise,
+/// return false without consuming any tokens.
+bool Parser::TrySkipCCEScopeAnnotation() {
+  // Must start with '['
+  if (Tok.isNot(tok::l_square))
+    return false;
+
+  // Peek: the token after '[' must be an identifier that is a known CCE scope.
+  const Token &Next = NextToken();
+  if (Next.isNot(tok::identifier))
+    return false;
+
+  IdentifierInfo *II = Next.getIdentifierInfo();
+  if (!II)
+    return false;
+
+  StringRef Name = II->getName();
+  if (Name != "aicore" && Name != "aicpu" && Name != "host")
+    return false;
+
+  // This looks like a CCE scope annotation. Consume '[', identifier, and
+  // optionally ', identifier' repeated, then ']'.
+  ConsumeBracket(); // '['
+  ConsumeToken();   // first identifier (aicore/aicpu/host)
+
+  // Consume optional comma-separated identifiers: [aicore, host]
+  while (Tok.is(tok::comma)) {
+    ConsumeToken(); // ','
+    if (Tok.is(tok::identifier))
+      ConsumeToken(); // next scope identifier
+  }
+
+  // Expect and consume ']'
+  if (Tok.is(tok::r_square))
+    ConsumeBracket();
+
+  return true;
+}
